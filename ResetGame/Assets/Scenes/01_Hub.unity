  m_Script: {fileID: 11500000, guid: 5e089efe10fec134c9513a1a0b0d411a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TriggerDialogue
  dialogue:
    lines:
    - npcName: Consola
      sentence: Bien hecho. Pero queda mucho camino por delante.
    - npcName: Jugador
      sentence: "Y ahora qu\xE9, me han dado la caja de herramientas que he usado.
        \xBFQu\xE9 hago con ella?"
    - npcName: Consola
      sentence: "No tienes que hacer nada, cada nivel te dar\xE1 un n\xFAcleo en
        forma de un objeto representativo de ese nivel, tendr\xE1s que conseguirlos
        todos para poder avanzar y ayudarme... la energ\xEDa se va agotando..."
    - npcName: Consola
      sentence: Agh...
    - npcName: Consola
      sentence: "Alguien... est\xE1... rompi\xE9ndome... debo irme..."
    - npcName: Jugador
      sentence: "\xBFAlguien?"
    - npcName: Consola
      sentence: "Sigue con tu misi\xF3n... el segundo nivel de The Last Reset es
        un poco diferente al primero... "
    - npcName: Consola
      sentence: ...
    - npcName: Jugador
      sentence: "\xBFDiferente? Tendr\xE9 que aprender de nuevo..."
  dialogoID: dialogo_2_hub
  coresRequeridos: 1
